# Copy to .env.local and fill in real values. .env* is gitignored — never commit it.
#
# Both vars are read only by src/lib/cms/client.ts, which runs server-side.
# Deliberately NOT prefixed NEXT_PUBLIC_: that prefix inlines a value into the
# client bundle, which would publish the key to every visitor.

# Base URL of the CMS API, including /api/v1.
# Note: next.config.ts reads this at BUILD time to allow the CMS's image host,
# so with output: "standalone" a new CMS host needs a rebuild, not a restart.
CMS_API_BASE_URL=http://localhost:8001/api/v1

# Shared secret for the CMS's site endpoint. Must match SITE_API_KEY in the CMS
# .env exactly. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Unset means the site renders its bundled fallback content.
CMS_SITE_API_KEY=
